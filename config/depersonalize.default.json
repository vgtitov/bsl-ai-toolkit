{
  "_comment": "Маска onec-data по умолчанию: единственное место правды. Токены: подстрока в имени поля, регистр не важен. Шаблоны: regex по значению. Все примеры в тестах вымышленные. ONEC_DATA_MASK_FIELDS добавляет токены к этому списку, не заменяет его. Токены работают как подстроки: «адрес» закрывает и «АдресХранения»; лишнее снимается только ONEC_DATA_MASK_OFF на тест-базе.",
  "mask_fields": [
    "фио",
    "фамилия",
    "имя",
    "отчество",
    "телефон",
    "инн",
    "кпп",
    "снилс",
    "паспорт",
    "email",
    "почта",
    "адресэп",
    "датарождения",
    "оклад",
    "зарплат",
    "заработн",
    "адрес",
    "унп",
    "номерсчета",
    "iban",
    "личныйномер",
    "идентификационныйномер",
    "парол",
    "password",
    "токен",
    "token",
    "секрет",
    "secret",
    "ключдоступа",
    "apikey",
    "логин",
    "login",
    "authorization",
    "cookie",
    "api_key",
    "api-key",
    "pwd",
    "passwd",
    "privatekey",
    "accesskey",
    "access_key",
    "private_key",
    "pass",
    "pincode",
    "пинкод"
  ],
  "value_patterns": [
    {
      "name": "унп рядом с меткой",
      "regex": "(?i)(?<![A-Za-zА-Яа-яЁё_])(?:унп|vat)(?![A-Za-zА-Яа-яЁё_])[^\\d\\n;]{0,40}\\d{9}(?!\\d)"
    },
    {
      "name": "iban",
      "regex": "\\b[A-Z]{2}\\d{2}(?: ?[A-Z0-9]{4}){2,7}(?: ?[A-Z0-9]{1,4})?\\b"
    },
    {
      "name": "телефон СНГ",
      "regex": "(?<!\\d)\\+(?:375|996|998|374|7)(?:[\\s()-]*\\d){8,10}(?!\\d)"
    },
    {
      "name": "телефон РБ без плюса",
      "regex": "(?<!\\d)(?:8[\\s(-]*0\\d{2}|375[\\s(-]*\\d{2})[\\s)-]*\\d{3}[\\s-]*\\d{2}[\\s-]*\\d{2}(?!\\d)"
    },
    {
      "name": "личный номер РБ",
      "regex": "(?i)(?<![A-Za-z0-9])\\d{7}[A-Z]\\d{3}[A-Z]{2}\\d(?![A-Za-z0-9])"
    },
    {
      "name": "jwt",
      "regex": "\\beyJ[\\w.-]{20,}"
    },
    {
      "name": "секрет в тексте",
      "regex": "(?i)(?:\\b(?:bearer|basic)\\s+(?=[A-Za-z0-9+/=._-]{8,})|(?:passw(?:or)?d|парол)\\w{0,30}(?:\\s+(?:от|для|for|of)\\s+\\S+)?(?:\\s+(?:is|это))?[\"'>\\s:=–—-]{1,20}|(?:pwd|\\bpass\\b|\\bpin\\b|token|secret|api[\\s_-]?key|\\bпин\\b|пин-?код|токен|секрет|ключ\\s+доступа)\\w{0,30}(?:\\s+(?:от|для|for|of)\\s+\\S+)?(?:\\s+(?:is|это))?[\"'>\\s]*[:=>\"'–—][\"'>\\s:=–—-]{0,19})[^\\n]+"
    },
    {
      "name": "приватный ключ PEM",
      "regex": "-----BEGIN [A-Z ]{0,30}PRIVATE KEY-----[\\s\\S]*?(?:-----END [A-Z ]{0,30}PRIVATE KEY-----|\\Z)"
    }
  ]
}
