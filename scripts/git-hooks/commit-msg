#!/bin/sh
# claude-no-coauthor: коммиты без соавторства/атрибуции AI-инструментов (любых, не только
# Claude/Anthropic — команда пользуется разными ассистентами: Copilot, ChatGPT и т.д.).
# Ставится автоматически scripts/install_git_hooks.py (через core.hooksPath). Этот файл —
# эталон для ручного слияния, если на машине уже есть свой commit-msg хук.
#
# Ловим по ФОРМЕ атрибуции (git-трейлер "Token: значение" с attribution-токеном, либо фраза
# "co-authored by / generated with|by / reviewed by / assisted by / written by" в строке),
# а не по списку имён — так работает и для инструментов, которых ещё не существует.
# Только grep (без awk/perl) — хук должен пережить урезанный PATH (EDT/EGit).
f="$1"; [ -f "$f" ] || exit 0

# Режем только по форме атрибуции, обычный текст коммита не трогаем:
#  - трейлер "<что-то>-by:" / "-session:" / "-generated:" / "-assisted:" (кроме Signed-off-by: это подпись человека, DCO, git commit -s);
#  - фраза-атрибуция В НАЧАЛЕ строки (после маркера списка и, возможно, одного значка-эмодзи, до 4 байт): "Generated with …",
#    "🤖 Generated with …"; такая же фраза посреди предложения ("шаблон generated by protoc") - обычный текст;
#  - адрес атрибуции: noreply@anthropic.com / openai.com / github.com и ссылка claude.ai/code/… (обычная ссылка на
#    документацию вендора в тексте коммита остаётся).
trailer='^[[:space:]]*[a-z0-9][a-z0-9_-]*(-by|-session|-generated|-assisted)[[:space:]]*:'
lead='^[[:space:][:punct:]]*([^[:alnum:][:space:][:punct:]]{1,4}[[:space:]]+)?'
verb="${lead}(co[[:space:]-]*authored[[:space:]-]*by|reviewed[[:space:]-]*by|assisted[[:space:]-]*by|generated[[:space:]-]*(with|by)|written[[:space:]-]*by)"
domain='@(anthropic|openai)\.com|noreply@github\.com|claude\.ai/code'
keep='^[[:space:]]*signed-off-by[[:space:]]*:'

# Номера строк-атрибуций (grep -n: "N:строка"), без внешних утилит кроме grep.
drop=" "
while IFS= read -r hit; do drop="$drop${hit%%:*} "; done <<EOF
$(grep -niE "${trailer}|${verb}|${domain}" "$f" 2>/dev/null)
EOF
[ "$drop" = " " ] && exit 0
saved=" "
while IFS= read -r hit; do saved="$saved${hit%%:*} "; done <<EOF
$(grep -niE "${keep}" "$f" 2>/dev/null)
EOF

tmp="$f.noai.$$"
n=0
{
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    case "$drop" in *" $n "*) case "$saved" in *" $n "*) ;; *) continue ;; esac ;; esac
    printf '%s\n' "$line"
  done < "$f"
} > "$tmp" 2>/dev/null && mv "$tmp" "$f" || rm -f "$tmp"
exit 0
