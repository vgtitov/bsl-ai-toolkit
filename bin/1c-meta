#!/usr/bin/env python3
"""1c-meta — headless CLI редактирования метаданных 1С (Конфигуратор-XML).

Подкоманды соответствуют операциям onec_metadata/ops. Ошибка предусловия
(объект не найден, дубль) — exit 2 с сообщением в stderr; файлы не меняются.
"""
import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from onec_metadata.formats.detect import detect_format, UnknownFormatError  # noqa: E402
from onec_metadata.ops import OpPreconditionError  # noqa: E402


def build_parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(prog="1c-meta")
    sub = ap.add_subparsers(dest="cmd", required=True)

    d = sub.add_parser("detect", help="определить формат дерева исходников")
    d.add_argument("root")

    t = sub.add_parser("template", help="операции с макетами печатных форм")
    tsub = t.add_subparsers(dest="tcmd", required=True)
    tac = tsub.add_parser("add-column")
    tac.add_argument("file")
    tac.add_argument("--after", required=True, help="заголовок колонки-якоря")
    tac.add_argument("--header", required=True, help="заголовок новой колонки")
    tac.add_argument("--parameter", required=True, help="имя параметра данных")

    s = sub.add_parser("scd", help="операции со схемой компоновки данных")
    ssub = s.add_subparsers(dest="scmd", required=True)
    saf = ssub.add_parser("add-field")
    saf.add_argument("file")
    saf.add_argument("--dataset", required=True)
    saf.add_argument("--field", required=True)
    saf.add_argument("--data-path", required=True)
    saf.add_argument("--title", required=True)
    sgq = ssub.add_parser("get-query")
    sgq.add_argument("file")
    sgq.add_argument("--dataset", required=True)
    ssq = ssub.add_parser("set-query")
    ssq.add_argument("file")
    ssq.add_argument("--dataset", required=True)
    ssq.add_argument("--from-file", required=True)
    sv = ssub.add_parser("validate",
                         help="smoke-проверка целостности схемы СКД (exit 1 если поломка)")
    sv.add_argument("file")

    bg = sub.add_parser(
        "bsl-gate", help="гейт производительности BSL (запрос-в-цикле) для дерева")
    bgsub = bg.add_subparsers(dest="bgcmd", required=True)
    bgc = bgsub.add_parser("check", help="exit 1, если есть находки сверх baseline")
    bgc.add_argument("root")
    bgb = bgsub.add_parser("baseline",
                           help="зафиксировать текущие находки как легаси")
    bgb.add_argument("root")

    a = sub.add_parser("attr", help="реквизиты объектов метаданных")
    asub = a.add_subparsers(dest="acmd", required=True)
    aa = asub.add_parser("add")
    aa.add_argument("file")
    aa.add_argument("--name", required=True)
    aa.add_argument("--type", dest="type_ref", required=True)
    aa.add_argument("--synonym", required=True)

    c = sub.add_parser(
        "child", help="дочерние элементы: Dimension/Resource/Attribute/EnumValue")
    csub = c.add_subparsers(dest="ccmd", required=True)
    ca = csub.add_parser("add")
    ca.add_argument("file")
    ca.add_argument("--kind", required=True,
                    help="Attribute|Dimension|Resource|EnumValue|TabularSection|"
                         "Command|AddressingAttribute")
    ca.add_argument("--name", required=True)
    ca.add_argument("--synonym", required=True)
    ca.add_argument("--type", dest="type_ref",
                    help="обязателен для типизированных видов")
    ca.add_argument("--parent",
                    help="имя табличной части — добавить элемент внутрь неё")
    ca.add_argument("--donor",
                    help="объект-донор образца (если в целевом нет образца вида)")

    sb = sub.add_parser("subsystem", help="состав подсистемы (командный интерфейс)")
    sbsub = sb.add_subparsers(dest="sbcmd", required=True)
    sbc = sbsub.add_parser("add-content")
    sbc.add_argument("file")
    sbc.add_argument("--ref", required=True,
                     help="ссылка объекта вида Тип.Имя (напр. Document.Заказ)")
    sbr = sbsub.add_parser("remove-content")
    sbr.add_argument("file")
    sbr.add_argument("--ref", required=True, help="ссылка объекта вида Тип.Имя")

    sp = sub.add_parser("set-property",
                        help="изменить существующее скалярное свойство объекта/реквизита")
    sp.add_argument("file")
    sp.add_argument("--name", required=True, help="имя свойства (тег)")
    sp.add_argument("--value", required=True, help="новое значение")
    sp.add_argument("--attribute", help="имя реквизита (иначе — свойство объекта)")

    sy = sub.add_parser("set-synonym",
                        help="сменить синоним (Наименование) существующего языка — безопасная презентация")
    sy.add_argument("file")
    sy.add_argument("--text", required=True, help="новый текст синонима")
    sy.add_argument("--member", "--attribute", dest="member", default=None,
                    help="имя реквизита/измерения/ресурса; без него — синоним самого объекта")
    sy.add_argument("--lang", default="ru", help="код языка (по умолчанию ru)")

    fm = sub.add_parser("form", help="правка управляемых форм")
    fmsub = fm.add_subparsers(dest="fmcmd", required=True)
    fac = fmsub.add_parser("add-attribute-column", help="колонка реквизита формы «таблица значений» (Конфигуратор и EDT)")
    fac.add_argument("file")
    fac.add_argument("--attribute", required=True)
    fac.add_argument("--name", required=True)
    fac.add_argument("--type", dest="type_ref", required=True, help="String | Boolean | Date | Number:N[.M] | cfg:CatalogRef.Имя")
    fac.add_argument("--title", action="append", default=[], help="ru=Текст (повторяемый)")
    faf = fmsub.add_parser("add-form-attribute", help="реквизит формы с нуля: String | Number:N | Boolean | Date | v8:ValueListType | dcsset:SettingsComposer | cfg:XRef.Имя (Конфигуратор)")
    faf.add_argument("file")
    faf.add_argument("--name", required=True)
    faf.add_argument("--type", dest="type_ref", required=True)
    faf.add_argument("--title", action="append", default=[], help="ru=Текст (повторяемый)")
    frc = fmsub.add_parser("remove-attribute-column", help="удалить колонку реквизита формы (Конфигуратор и EDT)")
    frc.add_argument("file")
    frc.add_argument("--attribute", required=True)
    frc.add_argument("--name", required=True)
    fra = fmsub.add_parser("remove-attribute", help="удалить реквизит формы без привязанных элементов (Конфигуратор и EDT)")
    fra.add_argument("file")
    fra.add_argument("--name", required=True)
    frm = fmsub.add_parser("remove-command", help="удалить команду формы без кнопок (Конфигуратор)")
    frm.add_argument("file")
    frm.add_argument("--name", required=True)
    fct = fmsub.add_parser("set-command-title", help="заголовок и подсказка команды формы (Конфигуратор)")
    fct.add_argument("file")
    fct.add_argument("--name", required=True)
    fct.add_argument("--title", action="append", default=[], help="ru=Текст (повторяемый)")
    fma = fmsub.add_parser("add-attribute")
    fma.add_argument("file", help="путь к Forms/<Имя>/Ext/Form.xml (или Form.form EDT)")
    fma.add_argument("--name", required=True, help="имя реквизита формы")
    fma.add_argument("--type", dest="type_ref", required=True, help="тип реквизита")
    fma.add_argument("--title", action="append", default=[],
                     help="ru=Текст (повторяемый; только EDT, Конфигуратор - add-form-attribute)")
    fmt = fmsub.add_parser("set-attribute-type",
                           help="тип СУЩЕСТВУЮЩЕГО реквизита формы, в т.ч. основного (EDT и Конфигуратор)")
    fmt.add_argument("file", help="Forms/<Имя>/Form.form (EDT) или Forms/<Имя>/Ext/Form.xml (Конфигуратор)")
    fmt.add_argument("--name", required=True, help="имя реквизита формы")
    fmt.add_argument("--type", dest="type_refs", action="append", required=True,
                     help="тип: EDT - DataProcessorObject.Имя / CatalogRef.Имя / String; "
                          "Конфигуратор - cfg:.../xs:...; повторить --type = составной тип")
    fmf = fmsub.add_parser("add-field")
    fmf.add_argument("file", help="путь к Forms/<Имя>/Ext/Form.xml (Конфигуратор)")
    fmf.add_argument("--name", required=True, help="имя элемента (InputField)")
    fmf.add_argument("--data-path", required=True, help="привязка данных, напр. Объект.Артикул")
    fmf.add_argument("--parent", help="контейнер (таблица/группа): поле встаёт внутрь (только EDT Form.form)")
    fmf.add_argument("--position", help="first | last | before:Имя | after:Имя (с --parent)")
    fmf.add_argument("--checkbox", action="store_true",
                     help="поле-флажок (CheckBoxField), с --parent (только EDT Form.form)")
    fms = fmsub.add_parser("set-style",
                           help="оформление элемента в свойствах формы (EDT и Конфигуратор)")
    fms.add_argument("file", help="Forms/<Имя>/Form.form (EDT) или Forms/<Имя>/Ext/Form.xml (Конфигуратор)")
    fms.add_argument("--item", required=True, help="имя элемента; '.' — сама форма")
    fms.add_argument("--set", dest="props", action="append", required=True, metavar="ИМЯ=ЗНАЧЕНИЕ",
                     help="свойство: backColor=style:примЦветФона, textColor=rgb:74,74,74, "
                          "font=style:NormalTextFont,face=Gilroy,height=10,bold, group=Vertical")
    fms.add_argument("--omit-defaults", action="store_true",
                     help="Конфигуратор: не писать значение, равное умолчанию (как выгрузка); по умолчанию пишется явно")
    for cmd, hlp in (("add-group", "новая группа: обычная, группа страниц или страница (Конфигуратор Form.xml)"),
                     ("add-decoration", "новая надпись/картинка (Конфигуратор Form.xml)"),
                     ("move", "перенести элемент в другую группу / сменить порядок (Конфигуратор Form.xml)"),
                     ("add-table", "новая таблица с привязкой --data-path (Конфигуратор Form.xml)"),
                     ("add-column", "колонка таблицы: --parent <Таблица|ГруппаКолонок> --data-path (Конфигуратор)"),
                     ("add-column-group", "группа колонок: --parent <Таблица|ГруппаКолонок> (Конфигуратор)"),
                     ("add-button", "кнопка команды --command Form.Command.X | Catalog.X.Command.Y (Конфигуратор)"),
                     ("add-checkbox", "флажок с привязкой --data-path (Конфигуратор Form.xml)"),
                     ("remove", "удалить элемент формы со всем вложенным (Конфигуратор Form.xml)")):
        p = fmsub.add_parser(cmd, help=hlp)
        p.add_argument("file", help="Forms/<Имя>/Ext/Form.xml")
        p.add_argument("--name", required=True, help="имя элемента")
        p.add_argument("--parent", default=".", help="родитель: группа, таблица, группа колонок; '.' — корень")
        p.add_argument("--position", default="last", help="first | last | before:Имя | after:Имя")
        if cmd == "add-decoration":
            p.add_argument("--kind", default="Label", choices=["Label", "Picture"])
        if cmd in ("add-table", "add-column", "add-checkbox"):
            p.add_argument("--data-path", required=True, help="напр. Объект.Товары / Объект.Товары.Номенклатура")
        if cmd == "add-column":
            p.add_argument("--edit-mode", choices=["Enter", "EnterOnInput", "Directly"],
                           help="EditMode колонки (по умолчанию не пишется)")
        if cmd == "add-group":
            p.add_argument("--kind", default="Usual", choices=["Usual", "Pages", "Page"],
                           help="Usual — обычная группа, Pages — группа страниц, Page — страница (в Pages)")
        if cmd == "add-button":
            p.add_argument("--command", required=True, help="Form.Command.<Имя> или <Объект>.Command.<Имя>")
    fmc = fmsub.add_parser("add-command", help="команда формы с заголовком и обработчиком (Конфигуратор Form.xml)")
    fmc.add_argument("file", help="Forms/<Имя>/Ext/Form.xml")
    fmc.add_argument("--name", required=True, help="имя команды")
    fmc.add_argument("--title", action="append", required=True, metavar="ЯЗЫК=ТЕКСТ", help="заголовок, по языкам")
    fmc.add_argument("--action", default="", help="обработчик в модуле формы (по умолчанию — имя команды)")
    fme = fmsub.add_parser("add-event", help="обработчик события формы (Конфигуратор Form.xml)")
    fme.add_argument("file", help="Forms/<Имя>/Ext/Form.xml")
    fme.add_argument("--event", required=True, help="событие платформы, напр. OnCreateAtServer")
    fme.add_argument("--handler", required=True, help="процедура в модуле формы")
    fmlst = fmsub.add_parser("add-list", help="реквизит формы «динамический список» по основной таблице (Конфигуратор)")
    fmlst.add_argument("file", help="Forms/<Имя>/Ext/Form.xml")
    fmlst.add_argument("--name", required=True, help="имя реквизита формы")
    fmlst.add_argument("--main-table", required=True, help="напр. Catalog.Товары, InformationRegister.Журнал")
    fmlst.add_argument("--main", action="store_true", help="основной реквизит формы")
    fmt = fmsub.add_parser("set-title", help="заголовок элемента на языках (Конфигуратор Form.xml)")
    fmt.add_argument("file", help="Forms/<Имя>/Ext/Form.xml")
    fmt.add_argument("--name", required=True, help="имя элемента; '.' — сама форма")
    fmt.add_argument("--title", action="append", required=True, metavar="ЯЗЫК=ТЕКСТ",
                     help="напр. --title ru=Поиск --title en=Search; остальные языки сохраняются")
    fmt.add_argument("--replace-all", action="store_true", help="заменить Title целиком, прочие языки удалить")
    fml = fmsub.add_parser("lint", help="проверка формы: языки заголовков, шрифты/цвета токенами, "
                                        "командная панель (только чтение; код 1 — есть находки)")
    fml.add_argument("file", help="Form.form (EDT) или Form.xml (Конфигуратор)")
    fml.add_argument("--langs", default="ru,en", help="обязательные языки заголовков (по умолчанию ru,en)")
    fml.add_argument("--checks", default="titles,tokens,command-bar,layout",
                     help="группы проверок: titles,tokens,command-bar,layout; без фирменного оформления — titles,layout")

    et = sub.add_parser("edit-type",
                        help="задать/сменить тип реквизита/измерения/ресурса или самого объекта")
    et.add_argument("file")
    et.add_argument("--attribute", "--member", dest="attribute", default=None,
                    help="имя реквизита/измерения/ресурса; без него — тип самого объекта "
                         "(параметр сеанса/константа/определяемый тип)")
    et.add_argument("--type", dest="type_ref", required=True, action="append",
                    help="новый тип (напр. cfg:CatalogRef.Товары / xs:string / String); "
                         "повторить --type несколько раз = составной тип")
    et.add_argument("--length", type=int,
                    help="длина строкового типа (строит квалификатор, если его нет)")
    et.add_argument("--precision", type=int, help="точность числа (Digits/precision)")
    et.add_argument("--scale", type=int, help="масштаб числа (FractionDigits/scale)")

    rl = sub.add_parser("role", help="права роли (Rights.xml)")
    rlsub = rl.add_subparsers(dest="rlcmd", required=True)
    rg = rlsub.add_parser("grant")
    rg.add_argument("file", help="путь к Roles/<Роль>/Ext/Rights.xml")
    rg.add_argument("--ref", required=True,
                    help="ссылка объекта вида Тип.Имя (напр. Catalog.Товары)")
    rg.add_argument("--right", required=True,
                    help="имя права (Read/View/Insert/Update/Delete/…)")
    rg.add_argument("--value", choices=["true", "false"], default="true",
                    help="значение права (по умолчанию true)")

    return ap


def main() -> None:
    ns = build_parser().parse_args()
    try:
        if ns.cmd == "detect":
            print(detect_format(Path(ns.root)).name)
        elif ns.cmd == "template":
            from onec_metadata.ops.template_add_column import add_column
            add_column(Path(ns.file), ns.after, ns.header, ns.parameter)
        elif ns.cmd == "scd":
            from onec_metadata.ops import scd
            if ns.scmd == "add-field":
                scd.add_field(Path(ns.file), ns.dataset, ns.field,
                              ns.data_path, ns.title)
            elif ns.scmd == "get-query":
                print(scd.get_dataset_query(Path(ns.file), ns.dataset))
            elif ns.scmd == "validate":
                issues = scd.validate_schema(Path(ns.file))
                if issues:
                    for s in issues:
                        print(f"СКД: {s}", file=sys.stderr)
                    sys.exit(1)
                print("СКД валидна")
            else:
                scd.set_dataset_query(
                    Path(ns.file), ns.dataset,
                    Path(ns.from_file).read_text(encoding="utf-8"))
        elif ns.cmd == "attr":
            from onec_metadata.ops.attribute_add import add_attribute
            add_attribute(Path(ns.file), ns.name, ns.type_ref, ns.synonym)
        elif ns.cmd == "child":
            from onec_metadata.ops.add_child import add_child
            add_child(Path(ns.file), ns.kind, ns.name, ns.synonym,
                      ns.type_ref, ns.parent,
                      Path(ns.donor) if ns.donor else None)
        elif ns.cmd == "subsystem":
            from onec_metadata.ops.subsystem import add_content, remove_content
            (remove_content if ns.sbcmd == "remove-content" else add_content)(Path(ns.file), ns.ref)
        elif ns.cmd == "role":
            from onec_metadata.ops.role import grant_right
            grant_right(Path(ns.file), ns.ref, ns.right, ns.value == "true")
        elif ns.cmd == "set-synonym":
            from onec_metadata.ops.synonym import set_synonym
            set_synonym(Path(ns.file), ns.member, ns.text, ns.lang)
        elif ns.cmd == "set-property":
            from onec_metadata.ops.set_property import set_property
            set_property(Path(ns.file), ns.name, ns.value, ns.attribute)
        elif ns.cmd == "edit-type":
            from onec_metadata.ops.edit_type import edit_type
            edit_type(Path(ns.file), ns.attribute, ns.type_ref,
                      ns.length, ns.precision, ns.scale)
        elif ns.cmd == "bsl-gate":
            from onec_metadata.apply import bsl_gate
            from onec_metadata.apply.dumpload import ApplyError
            if ns.bgcmd == "baseline":
                path = bsl_gate.write_baseline(Path(ns.root))
                print(f"baseline записан: {path}")
            else:
                try:
                    bsl_gate.enforce(Path(ns.root))
                    print("bsl-gate: чисто (сверх baseline находок нет)")
                except ApplyError as e:
                    print(e, file=sys.stderr)
                    sys.exit(1)
        elif ns.cmd == "form":
            if ns.fmcmd in ("add-attribute-column", "remove-attribute-column", "remove-attribute", "add-form-attribute",
                            "remove-command", "set-command-title"):
                from onec_metadata.ops import form_attributes as fa
                tt = dict(x.split("=", 1) for x in getattr(ns, "title", []) or [])
                if ns.fmcmd == "add-form-attribute":
                    fa.add_form_attribute(Path(ns.file), ns.name, ns.type_ref, tt)
                elif ns.fmcmd == "add-attribute-column":
                    fa.add_attribute_column(Path(ns.file), ns.attribute, ns.name, ns.type_ref, tt)
                elif ns.fmcmd == "remove-attribute-column":
                    fa.remove_attribute_column(Path(ns.file), ns.attribute, ns.name)
                elif ns.fmcmd == "remove-attribute":
                    fa.remove_attribute(Path(ns.file), ns.name)
                elif ns.fmcmd == "remove-command":
                    fa.remove_command(Path(ns.file), ns.name)
                else:
                    fa.set_command_title(Path(ns.file), ns.name, tt)
            elif ns.fmcmd == "add-attribute":
                from onec_metadata.ops.form import add_attribute as form_add_attr
                form_add_attr(Path(ns.file), ns.name, ns.type_ref, dict(x.split("=", 1) for x in ns.title))
            elif ns.fmcmd == "set-attribute-type":
                from onec_metadata.ops.form import set_attribute_type
                set_attribute_type(Path(ns.file), ns.name, ns.type_refs)
            elif ns.fmcmd in ("add-group", "add-decoration", "move", "set-title",
                              "add-table", "add-column", "add-column-group",
                              "add-button", "add-command", "add-list", "add-event", "add-checkbox", "remove"):
                from onec_metadata.ops import form_structure as fs
                if ns.fmcmd == "add-checkbox":
                    fs.add_checkbox(Path(ns.file), ns.name, ns.data_path, ns.parent, ns.position)
                elif ns.fmcmd == "remove":
                    fs.remove_item(Path(ns.file), ns.name)
                elif ns.fmcmd == "add-event":
                    fs.add_event(Path(ns.file), ns.event, ns.handler)
                elif ns.fmcmd == "add-button":
                    fs.add_button(Path(ns.file), ns.name, ns.command, ns.parent, ns.position)
                elif ns.fmcmd == "add-command":
                    titles = {}
                    for kv in ns.title:
                        lang, sep, text = kv.partition("=")
                        if not sep or not lang:
                            raise OpPreconditionError(f"--title '{kv}': ожидается ЯЗЫК=ТЕКСТ")
                        titles[lang] = text
                    fs.add_command(Path(ns.file), ns.name, titles, ns.action)
                elif ns.fmcmd == "add-list":
                    fs.add_list(Path(ns.file), ns.name, ns.main_table, ns.main)
                elif ns.fmcmd == "add-table":
                    fs.add_table(Path(ns.file), ns.name, ns.data_path, ns.parent, ns.position)
                elif ns.fmcmd == "add-column":
                    fs.add_column(Path(ns.file), ns.name, ns.parent, ns.data_path, ns.position, ns.edit_mode)
                elif ns.fmcmd == "add-column-group":
                    fs.add_column_group(Path(ns.file), ns.name, ns.parent, ns.position)
                elif ns.fmcmd == "add-group":
                    fs.add_group(Path(ns.file), ns.name, ns.parent, ns.position, ns.kind)
                elif ns.fmcmd == "add-decoration":
                    fs.add_decoration(Path(ns.file), ns.name, ns.parent, ns.position, ns.kind)
                elif ns.fmcmd == "move":
                    fs.move_item(Path(ns.file), ns.name, ns.parent, ns.position)
                else:
                    titles = {}
                    for kv in ns.title:
                        lang, sep, text = kv.partition("=")
                        if not sep or not lang:
                            raise OpPreconditionError(f"--title '{kv}': ожидается ЯЗЫК=ТЕКСТ")
                        if lang in titles:
                            raise OpPreconditionError(f"--title: язык '{lang}' указан дважды")
                        titles[lang] = text
                    fs.set_title(Path(ns.file), ns.name, titles, replace_all=ns.replace_all)
            elif ns.fmcmd == "lint":
                from onec_metadata.ops.form_lint import lint_form
                issues = lint_form(Path(ns.file), langs=tuple(x.strip() for x in ns.langs.split(",") if x.strip()),
                                   checks=tuple(x.strip() for x in ns.checks.split(",") if x.strip()))
                for i in issues:
                    print(i)
                print(f"находок: {len(issues)}")
                sys.exit(1 if issues else 0)
            elif ns.fmcmd == "set-style":
                from onec_metadata.ops.form_style import set_style
                props = {}
                for kv in ns.props:
                    k, sep, v = kv.partition("=")
                    if not sep or not k:
                        raise OpPreconditionError(f"--set '{kv}': ожидается ИМЯ=ЗНАЧЕНИЕ")
                    props[k] = v
                set_style(Path(ns.file), ns.item, props, omit_defaults=ns.omit_defaults)
            else:
                from onec_metadata.ops.form import add_field as form_add_field
                form_add_field(Path(ns.file), ns.name, ns.data_path,
                               parent=ns.parent, position=ns.position, checkbox=ns.checkbox)
    except (OpPreconditionError, UnknownFormatError) as e:
        print(f"Ошибка предусловия: {e}", file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main()
