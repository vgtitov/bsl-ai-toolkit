# Шаблон .env — скопируйте в .env рядом и заполните под свой контур. Сам .env в git не попадает.
# Секреты — ТОЛЬКО здесь (в .env) или в переменных окружения; никогда в чат, коммиты, задачи.
# CLI (zabbix_perf.py, storage_map.py, atlassian.py, apdex_to_zabbix.py) подхватывают .env
# из текущего каталога, затем из корня репозитория; переменные окружения главнее файла.

# --- onec-code / onec-ops: чтение исходников 1С ---
ONEC_SRC_DIR=                 # каталог с выгруженными исходниками (EDT/конфигуратор)
ONEC_LAYERS_CONFIG=           # конфиг слоёв (см. config/layers.example.toml)

# --- onec-metadata (bin/1c-meta, apply-слой): программные правки метаданных ---
# Нужны ТОЛЬКО для apply в тест-базу (сам разбор/правка XML работают без них).
# Транспорт: по SSH к серверу 1С (нужны ssh, scp, tar — Windows 10+ имеет их из коробки)
# ИЛИ локально, если платформа стоит на этой машине (тогда ssh не нужен вовсе).
ONEC_1CV8_BIN=                # путь к 1cv8(.exe); иначе авто-поиск установленной платформы
ONEC_REMOTE_WORKDIR=          # рабочий каталог НА СЕРВЕРЕ для tar/логов; по умолчанию D:\src
                              # (локально рабочий каталог берётся временный, эта переменная не нужна)

# --- Учётка ИБ (designer_sync.py, scripts/onec_verify.py: ступени 1-2 тестирования) ---
# Логин един, пароль — по базе/контуру; КЛЮЧ = имя базы в ВЕРХНЕМ регистре (--contour).
ONEC_IB_USER=
ONEC_IB_PASS=                 # фолбэк, если нет пароля с суффиксом
# ONEC_IB_PASS_<КЛЮЧ>=        # напр. ONEC_IB_PASS_ERP_TEST

# --- onec-data (слой ДАННЫХ живой ИБ: OData L1-L2 + расширение ai_debug L3) ---
# Работает ТОЛЬКО с опубликованной на веб-сервере базой (публикация — действие админа,
# см. docs/onec-work-mechanisms.md). Без публикации слой данных не включается.
ONEC_DATA_MCP=                # путь к mcp/onec_data_mcp.py (для mcp/dev.mcp.json)
ONEC_DATA_BASE_URL=           # http://веб-сервер/ИмяПубликации (регистр имени — точно как в публикации)
ONEC_DATA_USERS=              # файл учёток исследуемых пользователей (см. config/users.example.json)
ONEC_DATA_DEFAULT_USER=       # alias учётки по умолчанию
ONEC_DATA_ODATA_PATH=         # по умолчанию /odata/standard.odata
ONEC_DATA_DEBUG_PATH=         # по умолчанию /hs/aidbg
ONEC_DATA_MAX_ROWS=           # потолок строк в ответе; по умолчанию 200
ONEC_DATA_FORBID_PRIVILEGED=  # 1 — запретить mode=privileged на клиенте (прод-профиль)
ONEC_DATA_MASK_FIELDS=        # доп. поля-маски ПДн через запятую
ONEC_DATA_MASK_OFF=           # 1 — снять маскирование (ТОЛЬКО тест-база)
ONEC_DATA_PRESETS=            # файл преднастроенных проверок (см. config/presets.example.json)
# SSH-хост сервера 1С — не env, а алиас в ~/.ssh/config (передаётся в Runner(host)).
# Настройки конкретной организации (хост, базы, версия платформы) — в её ПРИВАТНОМ репо настроек.

# --- Zabbix (zabbix_perf.py, onec-ops zabbix_*_tool): анализ производительности ---
# Токен: Zabbix UI → Профиль пользователя → API tokens (учётка read-only,
# в роли включены «Доступ к API» и «Управление API-токенами»).
ZABBIX_URL=                   # http://zabbix.example/api_jsonrpc.php (можно URL фронтенда)
ZABBIX_TOKEN=
# Пресеты контуров («--contour kz» = дашборды+хосты+окно+лимит ядер одним словом):
# по умолчанию config/zabbix-contours.toml (образец config/zabbix-contours.example.toml).
ZABBIX_CONTOURS_CONFIG=

# --- Карты структуры хранения (storage_map.py): таблица СУБД ↔ объект 1С ---
# Каталог карт по базам (index.json + <База>.csv). Импорт выгрузки:
#   python scripts/storage_map.py import <файл.xls|csv> --base <ИмяБазы>
# Если задан — perf-отчёт Zabbix сам расшифровывает таблицы в SQL-уликах.
# Без переменной берётся <репозиторий>/data/storage_maps, если существует
# (локализации могут зашивать карты прямо в свой репозиторий).
ONEC_STORAGE_MAPS_DIR=

# --- Prometheus (опционально, если метрики 1С отдаёт экспортер) ---
PROMETHEUS_URL=

# --- Jira / Confluence (atlassian.py) ---
# Server/DC: только *_PAT (Bearer): профиль → Personal Access Tokens (отдельно Jira и Confluence).
# Cloud: дополнительно *_USER (email) → Basic user:token.
JIRA_URL=
JIRA_PAT=
# JIRA_USER=
CONFLUENCE_URL=
CONFLUENCE_PAT=
# CONFLUENCE_USER=

# --- ServiceDesk Plus API v3 (scripts/servicedesk.py): чтение и создание заявок ---
SD_BASE_URL=                  # адрес портала до /api/v3 (облако вместе с /app/<портал>)
SD_API_KEY=                   # профиль пользователя SDP, API Key generation; права ключа: чтение и создание заявок
# SD_AUTH_SCHEME=authtoken    # или oauth (Authorization: Zoho-oauthtoken ...)
# SD_CONFIG=                  # конфиг шаблонов и групп, по умолчанию config/servicedesk.toml
# SD_ALLOW_HTTP=1             # разрешить http для внутреннего узла (по умолчанию только https)
# SD_ALLOWED_HOSTS=           # закрепить допустимые узлы через запятую
# GITLAB_TOKEN=               # для mr_review.py --mr: токен GitLab с правом чтения MR (или GITLAB_PERSONAL_ACCESS_TOKEN)
# GITLAB_HOST=                # узел GitLab для mr_review.py --mr (только имя узла и порт, токен уходит только на него)
# SD_AGENT_SEND=1              # разрешить отправку заявки по файлу решения человека без терминала (по умолчанию выключено)
# SD_APPROVAL_LEDGER=         # каталог меток использованных решений и блокировок, по умолчанию ~/.cache/ai_toolkit_sd_approvals

# --- Проверки и гейты (необязательные) ---
# BSL_JAR=                    # путь к bsl-language-server-*-exec.jar (scripts/detect_tools.py ставит и прописывает)
# BSL_CONFIG=                 # .bsl-language-server.json
# BSL_MEMORY_MB=4096          # -Xmx для JVM
# BSL_LS_VERSION=             # версия BSL LS для автоскачивания
# MCP_BSL_CONTEXT_VERSION=    # версия MCP справки по платформе для автоскачивания
# JAVA=                       # путь к java, если не в PATH (подойдёт JDK из 1C:EDT)
# AI_TOOLKIT_BSLLS_GATE=off   # отключить автопроверку BSL LS по частым ключам после правки
# ONEC_BSL_GUARD=             # управление детектором «запрос в цикле» в apply-слое
# AI_TOOLKIT_DISCIPLINE=warn  # Stop-хук дисциплины: warn (по умолчанию), enforce, off

# --- Второе мнение (scripts/second_opinion.py, scripts/mr_review.py --second-opinion) ---
# AI_TOOLKIT_COPILOT_CMD=     # команда корпоративного ассистента (читает вопрос со STDIN); onboard/copilot_setup.py настраивает сам
# AI_TOOLKIT_COPILOT_VISIBLE=1        # всегда показывать окно браузера Copilot (по умолчанию скрыто, окно только для входа)
# AI_TOOLKIT_COPILOT_NO_LOGIN_WINDOW=1  # никогда не открывать окно входа (сервер, CI)
# AI_TOOLKIT_CORP=1           # корпоративный код: отключить внешние звенья без договора
# OPENROUTER_API_KEY=         # ключ для звена «модель без обучения»
# AI_TOOLKIT_NOTRAIN=1        # явно разрешить это звено
# AI_TOOLKIT_NOTRAIN_MODEL=   # модель этого звена (по умолчанию openai/gpt-4.1-mini, бесплатные запрещены)

# --- Профиль и режимы установки ---
# ONEC_ACTIVE_PROFILE=        # franchise / sng / analyst / ops: задаёт командный онбординг, влияет на режим Ponytail
# ONEC_PROFILE=               # профиль onec-code (слои контура)
# ONEC_SRC_IGNORE=            # шаблоны путей, исключаемых из поиска onec-code

# --- onec-ops MCP как HTTP-сервис (server/) ---
# MCP_TRANSPORT=stdio         # stdio (по умолчанию) или http
# MCP_HOST=0.0.0.0
# MCP_PORT=8000

# --- onec-data: учётка (альтернатива файлу ONEC_DATA_USERS) ---
# ONEC_DATA_LOGIN=
# ONEC_DATA_PASSWORD=

# --- onec_metadata (apply-слой): пути платформы ---
# ONEC_V8_BIN=                # 1cv8 для designer_sync.py (иначе авто-поиск)
# ONEC_IBSRV_BIN=             # ibsrv (автономный сервер) для локального прогона
# ONEC_PLATFORM_ROOT=         # каталог установки платформы (для conf.cfg защиты)

# --- Центральный сервер onec-code для команды (server/docker-compose.yml, docs/deploy-center.md) ---
# ONEC_BEARER_TOKEN=          # общий секрет, клиент шлёт его в заголовке Authorization
# ONEC_PUBLIC_PORT=18000      # порт onec-code снаружи (Caddy)
# ONEC_OPS_PUBLIC_PORT=       # порт onec-ops
# ONEC_DATA_PUBLIC_PORT=      # порт onec-data
# ONEC_TJ_DIR=                # каталог технологического журнала для onec-ops
# ONEC_DATA_FORBID_PRIVILEGED= ONEC_DATA_MASK_FIELDS= ONEC_DATA_MAX_ROWS= ONEC_DATA_PRESETS=   # настройки onec-data, см. docs/data-access-architecture.md
# ONEC_MCP_MODE=              # local или central (scripts/switch_source.py)
# ONEC_MCP_URL=               # адрес центрального onec-code для режима central
# ZABBIX_USER=                # если Zabbix без токена API (логин, пароль в окружении)

# --- Оценочный стенд агента (scripts/agent_eval.py) ---
# AGENT_EVAL_CMD=claude -p     # команда запуска агента: промпт в STDIN, ответ в STDOUT

