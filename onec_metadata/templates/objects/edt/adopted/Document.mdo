<?xml version="1.0" encoding="UTF-8"?>
<mdclass:Document xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mdclass="http://g5.1c.ru/v8/dt/metadata/mdclass" xmlns:mdclassExtension="http://g5.1c.ru/v8/dt/metadata/mdclass/extension" uuid="{{uuid:1}}" extendedConfigurationObject="{{base_uuid}}">
  <producedTypes>
    <objectType typeId="{{uuid:2}}" valueTypeId="{{uuid:3}}"/>
    <refType typeId="{{uuid:4}}" valueTypeId="{{uuid:5}}"/>
    <selectionType typeId="{{uuid:6}}" valueTypeId="{{uuid:7}}"/>
    <listType typeId="{{uuid:8}}" valueTypeId="{{uuid:9}}"/>
    <managerType typeId="{{uuid:10}}" valueTypeId="{{uuid:11}}"/>
